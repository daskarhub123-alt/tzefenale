local ToggleSpamNames = false
local spamDelay = 0.5 -- سرعة الإسبام بين 0.5 و 1 ثانية

local nameList = {
    "افىحىلىك",
    "ذي ذبه ولا سالفه؟",
    "انقلع",
}

TextTab:AddToggle({
    Name = "اسبام الأسماء التلقائي",
    Default = false,
    Callback = function(Value)
        ToggleSpamNames = Value
        
        if ToggleSpamNames then
            task.spawn(function()
                while ToggleSpamNames do
                    for _, textMsg in ipairs(nameList) do
                        if not ToggleSpamNames then break end
                        
                        local args = {
                            [1] = textMsg,
                            [2] = nil --[[Color3]]
                        }
                        
                        game:GetService("ReplicatedStorage").UpdateTitleEvent:FireServer(unpack(args))
                        task.wait(spamDelay)
                    end
                end
            end)
        end
    end
})

